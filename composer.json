{
    "name": "radebatz/openapi-introspector",
    "description": "Reads what a framework already knows about itself and contributes it to an OpenAPI document.",
    "license": [
        "MIT"
    ],
    "homepage": "http://radebatz.net/mano/",
    "authors": [
        {
            "name": "Martin Rademacher",
            "email": "mano@radebatz.org"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs": "export XDEBUG_MODE=off && php-cs-fixer fix --allow-risky=yes",
        "rector": "rector process src tests",
        "lint": [
            "@cs --dry-run",
            "@rector --dry-run"
        ],
        "test": "export XDEBUG_MODE=off && phpunit",
        "analyse": [
            "export XDEBUG_MODE=off && phpstan analyse --memory-limit=2G"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Radebatz\\OpenApi\\Introspector\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Radebatz\\OpenApi\\Introspector\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "require": {
        "php": ">=8.2",
        "zircote/swagger-php": "dev-master"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.62.0",
        "laravel/framework": "^12.0 || ^13.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "slim/slim": "^4.0"
    }
}
